module main_alu
(
input [31:0] operand_1,
input [31:0] operand_2,
input [3:0]	 opcode,

output reg [31:0] sum,
output zero
);

reg zero_internal;
assign zero = zero_internal;

always @(*) begin
	sum = 32'b0;
	case(opcode)
	4'b0000: sum = operand_1 + operand_2;
	4'b0001: sum = operand_1 - operand_2;
	4'b0010: sum = operand_1 & operand_2;
	4'b0011: sum = operand_1 | operand_2;
	4'b0100: sum = operand_1 ^ operand_2;
	4'b0101: sum = ($signed(operand_1) < $signed(operand_2)) ? 1:0;
	4'b0110: sum = (operand_1 < operand_2) ? 1:0;
	4'b0111: sum = operand_1 << operand_2;
	4'b1000: sum = operand_1 >> operand_2;
	4'b1001: sum = $signed(operand_1) >>> operand_2;
	4'b1010: sum = operand_1 >> operand_2;
	4'b1011: sum = operand_1 >> operand_2;
	default : sum = 32'bx;
	endcase
	
	if (sum == 32'b0) begin
	   
	    
		
		zero_internal = 1;
	end
	else
		zero_internal = 0;
end 
endmodule
