module register_file(

    input clk,
    input reset,
 
    input RegWrite,
    
    input [31:0]next_inst, 
   
//    input[4:0] rs1_addr,
//    input[4:0] rs2_addr,
//    input[4:0] rd_addr,
    input[31:0] write_reg,

    output[31:0] rs1,
    output[31:0] rs2
 );
 
    wire [4:0]rs1_addr = next_inst[19:15];
    wire [4:0]rs2_addr = next_inst[24:20];
    wire [4:0]rd_addr = next_inst[11:7];
    reg[31:0] registers[31:0];

    always@(posedge clk or posedge reset) begin

    if (reset) begin
    registers[1] <= 32'b0;
    registers[0] <= 32'b0;
    registers[7] <= 32'b0;
    registers[2] <= 32'b0;
    registers[3] <= 32'b0;
    registers[4] <= 32'b0;
    registers[5] <= 32'b0;
    registers[6] <= 32'b0;
    registers[8] <= 32'b0;
    registers[9] <= 32'b0;
    registers[10] <= 32'b0;
    registers[11] <= 32'b0;
    registers[12] <= 32'b0;
    registers[13] <= 32'b0;
    registers[14] <= 32'b0;
    registers[15] <= 32'b0;
    registers[16] <= 32'b0;
    registers[17] <= 32'b0;
    registers[18] <= 32'b0;
    registers[19] <= 32'b0;
    registers[20] <= 32'b0;
    registers[21] <= 32'b0;
    registers[22] <= 32'b0;
    registers[23] <= 32'b0;
    registers[24] <= 32'b0;
    registers[25] <= 32'b0;
    registers[26] <= 32'b0;
    registers[27] <= 32'b0;
    registers[28] <= 32'b0;
    registers[29] <= 32'b0;
    registers[30] <= 32'b0;
    registers[31] <= 32'b0;
    end

    else begin

    if (RegWrite && rd_addr != 5'b0) begin
    
    registers[rd_addr] <= write_reg;

    end
  end
end

assign rs1 = registers[rs1_addr];

assign rs2 = registers[rs2_addr];

endmodule
